        };
        
        img.onerror = () => {
            throw new Error("Failed to load image from Pollinations");
        };

    } catch(e) {
        resultArea.innerHTML = `<span class="status error">Error: ${e.message}</span>`; 
        showToast("Generation Failed", "error");
    }
}

async function doOCR() {
    const file = document.getElementById('ocr-file').files[0];
    const lang = document.getElementById('ocr-lang').value;
    const resBox = document.getElementById('ocr-result');
    const progBox = document.getElementById('ocr-progress');
    
    if(!file) return showToast("Select an image first", 'error');
    
    resBox.value = "";
    progBox.textContent = "Processing... (This may take a moment)";
    
    try {
        // Using the shorthand Tesseract.recognize function for simplicity and stability
        const ret = await Tesseract.recognize(
            file,
            lang,
            { 
                logger: m => {
                    if(m.status === 'recognizing text') {
                         progBox.textContent = `Recognizing: ${(m.progress * 100).toFixed(0)}%`;
                    } else {
                         progBox.textContent = m.status;
                    }
                }
            }
        );
        
        resBox.value = ret.data.text;
        progBox.textContent = "Done!";
        showToast("Text Extracted!", 'success');
    } catch(e) {
        console.error(e);
        progBox.textContent = "Error: " + e.message;
        showToast("OCR Failed", 'error');
    }
}

