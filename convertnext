// 6. Converters
function convBase(type) {
    try {
        let val;
        if(type === 'dec') val = parseInt(document.getElementById('base-dec').value, 10);
        else if (type === 'bin') val = parseInt(document.getElementById('base-bin').value, 2);
        else val = parseInt(document.getElementById('base-hex').value, 16);

        if (isNaN(val)) return;

        if (type !== 'dec') document.getElementById('base-dec').value = val.toString(10);
        if (type !== 'bin') document.getElementById('base-bin').value = val.toString(2);
        if (type !== 'hex') document.getElementById('base-hex').value = val.toString(16).toUpperCase();
    } catch(e) {}
}

