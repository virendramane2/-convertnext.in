        prompt = st.text_area("Question", "Describe this image in detail.")
        
        if ai_img and prompt and api_key and st.button("Analyze Image"):
            with st.spinner("AI is seeing..."):
                try:
                    model = genai.GenerativeModel('gemini-1.5-flash')
                    img = Image.open(ai_img)
                    response = model.generate_content([prompt, img])
                    st.markdown(response.text)
                except Exception as e:
                    st.error(f"AI Error: {e}")
                    
    with tab2:
        st.subheader("AI Text Assistant")
        txt_input = st.text_area("Input Text")
        action = st.selectbox("Action", ["Summarize", "Fix Grammar", "Translate to Hindi", "Translate to Spanish"])
        
        if txt_input and api_key and st.button("Run AI"):
            with st.spinner("AI is thinking..."):
                try:
                    model = genai.GenerativeModel('gemini-pro')
                    full_prompt = f"{action} the following text:\n\n{txt_input}"
                    response = model.generate_content(full_prompt)
                    st.success("Response:")
                    st.write(response.text)
                except Exception as e:
                    st.error(f"Error: {e}")

