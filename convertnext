// PDF
async function mergePDFs() {
    if (typeof PDFLib === 'undefined') return showToast('Library not loaded', 'error');
    const files = document.getElementById('pdf-merge-input').files;
    if(files.length < 2) return showToast("Select 2+ PDFs", 'error');
    try {
        const doc = await PDFLib.PDFDocument.create();
        for(let f of files) {
            const d = await PDFLib.PDFDocument.load(await f.arrayBuffer());
            (await doc.copyPages(d, d.getPageIndices())).forEach(p => doc.addPage(p));
        }
        downloadBlob(new Blob([await doc.save()],{type:'application/pdf'}), 'merged.pdf');
    } catch(e) { showToast(e.message, 'error'); }
}
async function splitPDF() {
    const files = document.getElementById('pdf-merge-input').files;
    if(files.length !== 1) return showToast("Select 1 PDF", 'error');
    try {
        const doc = await PDFLib.PDFDocument.load(await files[0].arrayBuffer());
        for(let i=0; i<doc.getPageCount(); i++){
            const n = await PDFLib.PDFDocument.create();
            const [p] = await n.copyPages(doc, [i]); n.addPage(p);
            downloadBlob(new Blob([await n.save()],{type:'application/pdf'}), `page_${i+1}.pdf`);
        }
    } catch(e) { showToast(e.message, 'error'); }
}
async function imgsToPDF() {
    const files = document.getElementById('imgs-to-pdf-input').files;
    if(!files.length) return showToast("Select images", 'error');
    try {
        const { jsPDF } = window.jspdf; const doc = new jsPDF();
        const W = doc.internal.pageSize.getWidth(), H = doc.internal.pageSize.getHeight();
        for(let i=0; i<files.length; i++){
            if(i>0) doc.addPage();
            const d = await getImgData(files[i]);
            const r = Math.min(W/500, H/500); // simplified sizing
            doc.addImage(d, 'JPEG', 10, 10, 180, 0); // auto height
        }
        doc.save('images.pdf');
    } catch(e) { showToast(e.message, 'error'); }
}
