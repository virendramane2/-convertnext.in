# --- 5. FINANCE ---
elif selected_tool == "💰 Finance":
    st.header("💰 Financial Calculators")
    
    tab1, tab2, tab3 = st.tabs(["Loan EMI", "SIP Calculator", "Tax (Simple)"])
    
    with tab1:
        p = st.number_input("Loan Amount (P)", value=100000)
        r = st.number_input("Interest Rate (%)", value=8.5)
        n = st.number_input("Tenure (Years)", value=5)
        
        if st.button("Calculate EMI"):
            r_mon = r / (12 * 100)
            n_mon = n * 12
            emi = (p * r_mon * ((1 + r_mon)**n_mon)) / (((1 + r_mon)**n_mon) - 1)
            total_pay = emi * n_mon
            
            c1, c2, c3 = st.columns(3)
            c1.metric("Monthly EMI", f"₹{emi:,.2f}")
            c2.metric("Total Interest", f"₹{total_pay - p:,.2f}")
            c3.metric("Total Amount", f"₹{total_pay:,.2f}")

# --- 6. UNITS ---
elif selected_tool == "⚖️ Units & Calc":
    st.header("⚖️ Unit Converter")
    
    category = st.selectbox("Category", ["Length", "Weight", "Temperature"])
    val = st.number_input("Value", value=1.0)
    
    if category == "Length":
        u_from = st.selectbox("From", ["Meter", "Kilometer", "Foot", "Inch"])
        u_to = st.selectbox("To", ["Meter", "Kilometer", "Foot", "Inch"])
        # Simplified logic for demo
        factors = {"Meter":1, "Kilometer":1000, "Foot":0.3048, "Inch":0.0254}
        res = val * factors[u_from] / factors[u_to]
        st.metric("Result", f"{res} {u_to}")

