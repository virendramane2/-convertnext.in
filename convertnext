# --- FUNCTIONS ---

def get_image_download_link(img, filename, text):
    buffered = io.BytesIO()
    img.save(buffered, format="PNG")
    return st.download_button(label=text, data=buffered.getvalue(), file_name=filename, mime="image/png")

# --- 1. PDF TOOLS ---
if selected_tool == "📄 PDF Tools":
    st.header("📄 PDF Management")
    
    tab1, tab2, tab3 = st.tabs(["Merge PDFs", "Extract Text", "Images to PDF"])
    
    with tab1:
        st.subheader("Merge Files")
        uploaded_files = st.file_uploader("Select PDFs", type="pdf", accept_multiple_files=True)
        if uploaded_files and st.button("Merge PDFs"):
            merger = pypdf.PdfWriter()
            for pdf in uploaded_files:
                merger.append(pdf)
            
            buffer = io.BytesIO()
            merger.write(buffer)
            st.success("Merged successfully!")
            st.download_button("Download Merged PDF", data=buffer.getvalue(), file_name="merged.pdf", mime="application/pdf")

    with tab2:
        st.subheader("Extract Text")
        pdf_file = st.file_uploader("Select PDF for Text", type="pdf")
        if pdf_file:
            reader = pypdf.PdfReader(pdf_file)
            text = ""
            for page in reader.pages:
                text += page.extract_text() + "\n\n"
            st.text_area("Extracted Text", text, height=300)

    with tab3:
        st.subheader("Images to PDF")
        img_files = st.file_uploader("Select Images", type=['png', 'jpg', 'jpeg'], accept_multiple_files=True)
        if img_files and st.button("Convert to PDF"):
            images = [Image.open(f).convert('RGB') for f in img_files]
            pdf_buffer = io.BytesIO()
            images[0].save(pdf_buffer, save_all=True, append_images=images[1:], format="PDF")
            st.download_button("Download PDF", data=pdf_buffer.getvalue(), file_name="images.pdf", mime="application/pdf")

# --- 2. IMAGE TOOLS ---
elif selected_tool == "🖼️ Image Tools":
    st.header("🖼️ Image Tools")
    
    tab1, tab2, tab3, tab4 = st.tabs(["Background Remover", "Filters & Converter", "QR Code", "Passport Maker"])
    
    with tab1:
        st.subheader("Remove Background")
        uploaded_file = st.file_uploader("Upload Image", type=["jpg", "png", "jpeg"])
        if uploaded_file:
            image = Image.open(uploaded_file)
            st.image(image, caption="Original", use_column_width=True)
            
            if st.button("Remove Background"):
                with st.spinner("Processing..."):
                    try:
                        output = remove(image)
                        st.image(output, caption="Result", use_column_width=True)
                        get_image_download_link(output, "no-bg.png", "Download Result")
                    except Exception as e:
                        st.error(f"Error: {e}")

    with tab2:
        st.subheader("Converter & Filters")
        img_file = st.file_uploader("Upload", type=["jpg", "png", "webp"])
        if img_file:
            img = Image.open(img_file)
            col1, col2 = st.columns(2)
            with col1:
                filter_type = st.selectbox("Apply Filter", ["None", "Grayscale", "Blur", "Contour", "Detail"])
            with col2:
                format_type = st.selectbox("Convert To", ["PNG", "JPEG", "WEBP", "BMP"])
            
            if filter_type == "Grayscale": img = ImageOps.grayscale(img)
            elif filter_type == "Blur": img = img.filter(ImageFilter.BLUR)
            elif filter_type == "Contour": img = img.filter(ImageFilter.CONTOUR)
            
            st.image(img, caption="Preview")
            
            buf = io.BytesIO()
            save_format = "JPEG" if format_type == "JPG" else format_type
            # Handle RGBA to RGB for JPEG
            if save_format == "JPEG" and img.mode == "RGBA":
                img = img.convert("RGB")
                
            img.save(buf, format=save_format)
            st.download_button(f"Download as {format_type}", data=buf.getvalue(), file_name=f"image.{format_type.lower()}", mime=f"image/{format_type.lower()}")

    with tab3:
        st.subheader("QR Code Generator")
        qr_text = st.text_input("Enter URL or Text")
        if qr_text:
            qr = qrcode.make(qr_text)
            st.image(qr, width=300)
            buf = io.BytesIO()
            qr.save(buf, format="PNG")
            st.download_button("Download QR", data=buf.getvalue(), file_name="qrcode.png", mime="image/png")

# --- 3. AI STUDIO ---
elif selected_tool == "🤖 AI Studio":
    st.header("✨ AI Studio (Powered by Gemini)")
    
    if not api_key:
        st.warning("⚠️ Please enter your Gemini API Key in the sidebar to use these features.")
    
    tab1, tab2 = st.tabs(["Vision (Image Analysis)", "Text Lab"])
    
