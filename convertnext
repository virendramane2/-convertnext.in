<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>convertnext.in - Ultimate Utility Suite</title>
<meta name="description" content="A complete client-side utility suite for PDF, Images, Text, Data, Finance, and Units.">

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Cropper.js CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">

<style>
  :root {
    --bg-gradient: linear-gradient(135deg, #f6f9fc 0%, #eef2f7 100%);
    --card-bg: rgba(255, 255, 255, 0.95);
    --card-border: 1px solid rgba(255, 255, 255, 0.6);
    --text-main: #1e293b;
    --text-muted: #64748b;
    
    /* Brand Gradients */
    --primary-gradient: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    --primary-shadow: rgba(99, 102, 241, 0.3);
    
    /* Violet Gradient for Specific Tools */
    --violet-gradient: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    --violet-shadow: rgba(139, 92, 246, 0.3);
    
    /* AI Gradient */
    --ai-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);
    
    --danger: #ef4444;
    --success: #10b981;
    --warning: #f59e0b;
    
    --radius-lg: 20px;
    --radius-md: 12px;
    --radius-sm: 8px;
    
    --shadow-sm: 0 2px 8px rgba(0,0,0,0.05);
    --shadow-md: 0 12px 24px -6px rgba(0,0,0,0.08);
    --shadow-lg: 0 20px 35px -10px rgba(0,0,0,0.1);
    
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    font-family: 'Outfit', sans-serif;
    background: var(--bg-gradient);
    background-attachment: fixed;
    color: var(--text-main);
    margin: 0;
    padding: 20px;
    padding-top: 40px;
    line-height: 1.6;
    min-height: 100vh;
  }

  .wrap { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 30px; }

  header { text-align: center; margin-bottom: 10px; padding-top: 20px; position: relative; }
  
  /* API Key Input Styling */
  .api-key-container {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    gap: 5px;
    align-items: center;
    z-index: 100;
  }
  .api-key-input {
    padding: 6px 10px;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    font-size: 0.8rem;
    width: 150px;
    transition: all 0.3s;
    outline: none;
    background: rgba(255,255,255,0.8);
  }
  .api-key-input:focus { width: 200px; border-color: #8b5cf6; }
  .api-key-input.attention { border-color: #ef4444; box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.2); }

  #logo-img {
    display: block; margin: 0 auto 15px auto;
    max-width: 150px; height: auto;
    animation: popIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  h1 {
    margin: 0; font-size: 2.5rem; font-weight: 800; letter-spacing: -0.03em;
    background: var(--primary-gradient); -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; display: inline-block;
    animation: fadeInDown 0.8s ease-out 0.4s backwards;
  }
  .subtitle { font-size: 1rem; color: var(--text-muted); margin-top: 8px; font-weight: 400; animation: fadeIn 1s ease-out 0.7s backwards; }

  /* --- FIXED MAIN NAV BAR --- */
  .nav-bar {
    display: flex; 
    justify-content: center; 
    gap: 8px; 
    background: white; 
    padding: 8px; 
    border-radius: 50px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); 
    margin: 0 auto; 
    max-width: fit-content;
    animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) 1s backwards;
  }

  /* New Sticky Class for the Main Navigation - DOUBLE ROW EDIT */
  .nav-bar.main-nav {
    position: sticky;
    z-index: 1000;
    
    /* Use Grid for Double Row (4 items x 2 rows) */
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    
    /* Glassmorphism */
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.6);
    box-shadow: 0 8px 20px -4px rgba(0,0,0,0.1);
    
    /* Centering and sizing */
    max-width: 800px;
    margin: 0 auto 30px auto;
    padding: 10px 20px;
    border-radius: 20px;
    
    /* Reset scroll behavior */
    overflow-x: visible;
    justify-content: center;
  }

  /* Desktop Styling (Larger buttons) */
  @media(min-width: 900px) {
    .nav-bar.main-nav {
        top: 20px;
    }
  }

  /* Mobile/Tablet Styling */
  @media(max-width: 899px) {
     .nav-bar.main-nav {
        top: 10px;
        width: 95%;
        padding: 10px;
        gap: 6px;
     }
     /* Stack Icon and Text on Mobile to fit 4 in a row */
     .nav-bar.main-nav .nav-btn {
        flex-direction: column;
        gap: 4px;
        padding: 8px 4px;
        font-size: 0.75rem;
        text-align: center;
        border-radius: 12px;
     }
     /* Adjust header padding */
     header { padding-top: 10px; }
  }

  .nav-btn {
    background: transparent; border: none; padding: 10px 20px; border-radius: 40px;
    font-weight: 600; color: var(--text-muted); cursor: pointer; transition: var(--transition);
    font-family: inherit; font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center; /* Center content */
    gap: 6px;
  }
  .nav-btn:hover { color: var(--text-main); background: rgba(99, 102, 241, 0.08); }
  
  /* Distinct Active Colors for Sections */
  .nav-btn[data-target="pdf"].active { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3); }
  .nav-btn[data-target="image"].active { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3); }
  .nav-btn[data-target="signature"].active { background: linear-gradient(135deg, #0f172a 0%, #334155 100%); color: white; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.3); }
  .nav-btn[data-target="text"].active { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3); }
  .nav-btn[data-target="currency"].active { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
  .nav-btn[data-target="units"].active { background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white; box-shadow: 0 4px 12px rgba(6, 182, 212, 0.3); }
  .nav-btn[data-target="education"].active { background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); color: white; box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3); }
  .nav-btn[data-target="utilities"].active { background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%); color: white; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3); }
  .nav-btn.ai-nav-btn.active { background: var(--ai-gradient); color: white; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.4); }

  .tool-section { display: none; animation: slideUp 0.5s ease forwards; }
  .tool-section.active { display: block; }

  .card {
    background: var(--card-bg); border-radius: var(--radius-lg); padding: 30px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border: var(--card-border);
    margin-bottom: 25px; backdrop-filter: blur(10px);
  }
  
  .section-title {
    font-size: 1.25rem; font-weight: 700; margin-bottom: 20px; padding-bottom: 12px;
    border-bottom: 2px solid rgba(0,0,0,0.04); display: flex; align-items: center; gap: 10px;
  }
  .section-title::before { content: ''; display: block; width: 6px; height: 24px; background: var(--primary-gradient); border-radius: 4px; }
  .ai-title::before { background: var(--ai-gradient); }

  label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; }
  
  input, select, textarea {
    width: 100%; padding: 12px 16px; border: 2px solid #e2e8f0; border-radius: var(--radius-md);
    font-family: inherit; font-size: 1rem; background: #f8fafc; transition: var(--transition);
    box-sizing: border-box;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: #8b5cf6; background: white; }
  
  /* Color input specific */
  input[type="color"] { padding: 0; height: 45px; cursor: pointer; }
  
  textarea { resize: vertical; min-height: 120px; }

  button.action-btn {
    background: var(--primary-gradient); color: white; border: none; padding: 12px 24px;
    border-radius: var(--radius-sm); font-weight: 600; font-size: 1rem; cursor: pointer;
    transition: var(--transition); display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  }
  button.action-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4); }
  
  button.violet-btn {
    background: var(--violet-gradient); color: white; border: none; padding: 12px 24px;
    border-radius: var(--radius-sm); font-weight: 600; font-size: 1rem; cursor: pointer;
    transition: var(--transition); display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    box-shadow: 0 4px 10px var(--violet-shadow);
  }
  button.violet-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px var(--violet-shadow); }

  button.ai-btn { background: var(--ai-gradient); }
  
  button.secondary-btn {
    background: white; color: var(--text-main); border: 2px solid #e2e8f0; padding: 10px 20px;
    border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; transition: var(--transition);
  }
  button.secondary-btn:hover { border-color: #cbd5e1; background: #f8fafc; }

  .row { display: flex; gap: 15px; align-items: center; flex-wrap: wrap; margin-top: 20px; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; }
  
  .status { font-size: 0.9rem; font-weight: 500; margin-left: 10px; }
  .status.error { color: var(--danger); }
  .status.success { color: var(--success); }
  .status.loading { color: #8b5cf6; }
  
  .preview-area {
    margin-top: 20px; padding: 20px; background: #f8fafc; border-radius: var(--radius-md);
    border: 2px dashed #e2e8f0; min-height: 80px; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .preview-img { max-width: 100%; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }

  .emi-box { background: #f0f9ff; padding: 15px; border-radius: 12px; text-align: center; border: 1px solid #bae6fd; }
  .emi-val { font-size: 1.5rem; font-weight: 700; color: #0284c7; margin-top: 5px; }
  .emi-label { font-size: 0.8rem; text-transform: uppercase; color: #64748b; }

  .ai-response { background: #f0fdfa; border: 1px solid #ccfbf1; padding: 20px; border-radius: 12px; margin-top: 15px; white-space: pre-wrap; }
  
  #signature-pad { border: 2px solid #e2e8f0; border-radius: 8px; background: white; cursor: crosshair; touch-action: none; }
  
  /* Exif Table */
  .exif-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .exif-table th, .exif-table td { padding: 8px; text-align: left; border-bottom: 1px solid #e2e8f0; }
  .exif-table th { color: var(--text-muted); width: 40%; }
  
  /* Calculator Styles */
  .calc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 15px; }
  .calc-btn { padding: 15px; font-size: 1.2rem; border: 1px solid #e2e8f0; border-radius: 8px; background: white; cursor: pointer; transition: all 0.2s; font-weight: 600; }
  .calc-btn:hover { background: #f1f5f9; }
  .calc-btn.op { background: #f0f9ff; color: #0284c7; }
  .calc-btn.eq { background: var(--primary-gradient); color: white; border: none; grid-column: span 2; }
  .calc-display { width: 100%; padding: 15px; font-size: 1.5rem; text-align: right; border: 2px solid #cbd5e1; border-radius: 8px; margin-bottom: 10px; background: #fff; }
  
  .edu-tab { display: none; animation: slideIn 0.3s ease-out; }
  .edu-tab.active { display: block; }

  footer {
    text-align: center; margin-top: 40px; padding-bottom: 20px; color: var(--text-muted); font-size: 0.9rem; border-top: 1px solid rgba(0,0,0,0.05); padding-top: 20px;
  }

  /* Toast Notifications */
  .toast-container { position: fixed; top: 20px; right: 20px; z-index: 10000; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
  .toast { background: white; padding: 14px 20px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); border-left: 5px solid #6366f1; animation: slideIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); font-size: 0.95rem; font-weight: 500; display: flex; align-items: center; min-width: 280px; pointer-events: auto; }
  .toast.error { border-left-color: #ef4444; }
  .toast.success { border-left-color: #10b981; }
  .toast.loading { border-left-color: #f59e0b; }
  
  @media(max-width: 700px) { 
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .api-key-container { position: relative; justify-content: center; margin-bottom: 15px; right: auto; }
      
      /* Adjusted Header padding for mobile */
      header { padding-top: 40px; }
      
      /* Mobile Nav Button sizing */
      .nav-btn { padding: 8px 16px; font-size: 0.85rem; }
  }
  @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeInDown { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes popIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
  @keyframes slideIn { from { transform: translateX(10px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes fadeOut { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-20px); } }
</style>

<!-- External Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.2/marked.min.js"></script>
<!-- Imgly BG Removal -->
<script src="https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.0.5/dist/imgly-background-removal.min.js"></script>
<!-- NEW Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tesseract.js/4.1.1/tesseract.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exif-js/2.3.0/exif.min.js"></script>
<!-- MD5 Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/spark-md5/3.0.2/spark-md5.min.js"></script>
</head>
<body>

<div class="wrap">
  <header>
    <div class="api-key-container">
        <input type="password" id="user-api-key" class="api-key-input" placeholder="Paste Gemini API Key" onchange="saveApiKey()">
    </div>
    <img id="logo-img" src="https://ik.imagekit.io/bi3rpbyeo/ChatGPT_Image_Nov_19__2025__09_53_31_AM-removebg-preview.png" alt="Logo"> 
    <h1>convertnext.in</h1>
    <div class="subtitle">Secure Client-Side Utility Hub</div>
  </header>

  <!-- MAIN NAVIGATION (Added 'main-nav' class) -->
  <nav class="nav-bar main-nav">
    <button class="nav-btn active" data-target="pdf">📄 PDF</button>
    <button class="nav-btn" data-target="image">🖼️ Image</button>
    <button class="nav-btn" data-target="signature">✒️ Signature</button>
    <button class="nav-btn" data-target="text">📝 Text</button>
    <button class="nav-btn" data-target="currency">💎 Finance</button>
    <button class="nav-btn" data-target="units">⚖️ Units</button>
    <button class="nav-btn" data-target="education">🎓 Education</button>
    <button class="nav-btn" data-target="utilities">🛠️ Utilities</button>
  </nav>

  <!-- SECTION: PDF TOOLS -->
  <section id="pdf" class="tool-section active">
    <!-- ... existing PDF content ... -->
    <div class="card">
      <div class="section-title">PDF Management</div>
      <div class="grid-2">
          <div><label>Select PDFs</label><input id="pdf-merge-input" type="file" accept="application/pdf" multiple /></div>
      </div>
      <div class="row">
        <button id="pdf-merge-btn" class="action-btn">Merge Files</button>
        <button id="pdf-split-btn" class="violet-btn">Split PDF</button>
        <span id="pdf-merge-status" class="status"></span>
      </div>
    </div>
    <div class="card">
      <div class="section-title">Images to PDF</div>
      <label>Select Images</label><input id="imgs-to-pdf-input" type="file" accept="image/*" multiple />
      <div class="row"><button id="imgs-to-pdf-btn" class="action-btn">Generate PDF</button></div>
    </div>
    <div class="card">
      <div class="section-title">PDF Compressor</div>
      <label>Select PDF File</label>
      <input id="pdf-compress-file" type="file" accept="application/pdf" />
      <div class="grid-2" style="margin-top: 15px; align-items: start;">
         <div><label>Compression Mode</label><select id="pdf-compress-mode" onchange="togglePdfCompressMode()"><option value="quality">By Quality Level</option><option value="size">By Target Size (KB/MB)</option></select></div>
         <div id="pdf-mode-quality"><label>Level</label><select id="pdf-compress-level"><option value="0.8">Low Compression (Better Quality)</option><option value="0.5" selected>Medium Compression (Balanced)</option><option value="0.2">High Compression (Smallest Size)</option></select></div>
         <div id="pdf-mode-size" style="display:none;"><label>Target Size</label><div style="display:flex; gap:5px;"><input id="pdf-target-val" type="number" placeholder="e.g. 200" style="flex:1"><select id="pdf-target-unit" style="width:90px;"><option value="KB">KB</option><option value="MB">MB</option></select></div></div>
      </div>
      <div class="row"><button id="pdf-compress-btn" class="action-btn" style="width:100%;">Compress PDF</button></div>
      <div id="pdf-compress-status" class="status" style="margin-top:10px;"></div>
    </div>
    <div class="card">
        <div class="section-title">Unlock / Edit PDF</div>
        <div class="grid-2">
            <div><label>Unlock (Req. Pass)</label><input id="pdf-unlock-file" type="file"><input id="pdf-unlock-pass" type="password" placeholder="Password" style="margin-top:5px;"></div>
            <div><label>Add Watermark</label><input id="pdf-edit-file" type="file"><input id="pdf-edit-text" placeholder="Watermark Text" style="margin-top:5px;"></div>
        </div>
        <div class="row"><button id="pdf-unlock-btn" class="violet-btn">Unlock PDF</button><button id="pdf-edit-btn" class="violet-btn">Add Watermark</button></div>
    </div>
    <div class="card">
      <div class="section-title">PDF Text Extraction</div>
      <input id="pdf-extract-file" type="file" accept="application/pdf" />
      <div class="row"><button id="pdf-extract-btn" class="action-btn">Extract Text</button></div>
      <textarea id="pdf-extract-out" readonly placeholder="Text content..." style="margin-top:15px;"></textarea>
      <div class="row" style="justify-content: flex-end; border-top: 1px solid #e2e8f0; padding-top: 15px; margin-top: 15px;"><button id="btn-send-to-ai" class="action-btn ai-btn" style="display:none;">✨ Analyze with AI</button></div>
    </div>
    <div class="card">
      <div class="section-title">PDF to Image Converter</div>
      <label>Select PDF</label><input id="pdf-to-img-file" type="file" accept="application/pdf" />
      <div class="row">
         <div style="width: 140px;"><label>Quality Scale</label><input id="pdf-render-scale" type="number" value="1.5" step="0.5" min="1" max="3"></div>
        <button id="pdf-render-btn" class="action-btn" style="margin-top: 24px;">Convert Pages</button>
      </div>
      <div id="pdf-pages-output" class="preview-area"></div>
    </div>
  </section>

  <!-- SECTION: IMAGE TOOLS -->
  <section id="image" class="tool-section">
    <!-- ... existing image content ... -->
    <div class="card">
        <div class="section-title ai-title">✨ AI Vision (Image Analysis)</div>
        <label>Upload an Image</label>
        <input id="ai-image-file" type="file" accept="image/*" />
        <div class="grid-2" style="margin-top:15px;">
            <div id="ai-image-preview" class="preview-area" style="min-height:200px;"><span class="status">Image Preview</span></div>
            <div><label>Ask a question about the image</label><textarea id="ai-image-prompt" style="height:100px;" placeholder="Describe this image..."></textarea><button id="ai-vision-btn" class="action-btn ai-btn" style="width:100%; margin-top:10px;">✨ Analyze Image</button></div>
        </div>
        <div id="ai-vision-output-container" style="display:none;"><label style="margin-top:20px;">AI Analysis</label><div id="ai-vision-output" class="ai-response"></div></div>
    </div>
    <div class="card">
        <div class="section-title ai-title">✨ Free AI Image Generator</div>
        <label>Describe the image you want to create</label>
        <textarea id="ai-gen-prompt" placeholder="A futuristic city with flying cars, cyberpunk style, 4k render..." style="height:80px;"></textarea>
        <div class="row"><button id="btn-ai-gen" class="action-btn ai-btn" style="width:100%">✨ Generate Image (Free)</button></div>
        <div id="ai-gen-result" class="preview-area" style="min-height:200px; display:none;"></div>
    </div>
    <div class="card">
      <div class="section-title">📝 OCR (Image to Text)</div>
