function populateUnits() { 
    const c = document.getElementById('unit-category').value; 
    const unitSelects = [document.getElementById('unit-from'), document.getElementById('unit-to')];
    const ops = Object.keys(unitData[c]).map(u => {
        const label = u.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        return `<option value="${u}">${label}</option>`;
    }).join(''); 
    unitSelects.forEach(s => s.innerHTML = ops);
}
function convertUnits() { 
    const c = document.getElementById('unit-category').value;
    const f = document.getElementById('unit-from').value;
    const t = document.getElementById('unit-to').value;
    const v = parseFloat(document.getElementById('unit-input').value);
    let r = 0; 
    if(c === 'temp'){ 
        /* Temp logic */ 
        if(f===t) r=v;
        else if(f==='celsius'&&t==='fahrenheit') r=v*9/5+32;
        else if(f==='celsius'&&t==='kelvin') r=v+273.15;
        else if(f==='fahrenheit'&&t==='celsius') r=(v-32)*5/9;
        else if(f==='fahrenheit'&&t==='kelvin') r=(v-32)*5/9+273.15;
        else if(f==='kelvin'&&t==='celsius') r=v-273.15;
        else if(f==='kelvin'&&t==='fahrenheit') r=(v-273.15)*9/5+32;
    } else { 
        r = v * unitData[c][f] / unitData[c][t]; 
    } 
    document.getElementById('unit-result').textContent = `${parseFloat(r.toPrecision(6))} ${t}`; 
}

